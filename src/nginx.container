[Unit]
Description=nginx web server
# Avoid podman waiting for online network
DefaultDependencies=false
After=network.target

[Container]
Image=docker.io/library/nginx:mainline-alpine
ContainerName=nginx

PublishPort=8443:443

Volume=%h/nginx/conf.d/:/etc/nginx/conf.d/:ro
Volume=%h/nginx/certs/:/etc/nginx/certs:ro
Volume=%h/nginx/contents/:/srv/nginx/

AutoUpdate=registry

[Service]
ExecReload=/usr/bin/podman exec nginx /usr/sbin/nginx -s reload
Restart=always

[Install]
WantedBy=default.target
